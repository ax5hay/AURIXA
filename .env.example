# AURIXA Environment Configuration
# Copy to .env and adjust values

NODE_ENV=development
LOG_LEVEL=debug

# Service Ports
API_GATEWAY_PORT=3000
ORCHESTRATION_PORT=8001
LLM_ROUTER_PORT=8002
AGENT_RUNTIME_PORT=8003
RAG_SERVICE_PORT=8004
SAFETY_PORT=8005
VOICE_PORT=8006
EXECUTION_PORT=8007
OBSERVABILITY_PORT=8008
DEPLOYMENT_CONTROLLER_PORT=8009

# Auth (plug in later)
JWT_SECRET=change-me-in-production
JWT_ISSUER=aurixa
JWT_EXPIRY=3600

# Deployment control plane (deny-by-default)
# Use a dedicated high-entropy secret, not JWT_SECRET. Tokens must include:
# iss=DEPLOYMENT_JWT_ISSUER, aud=DEPLOYMENT_JWT_AUDIENCE, sub, exp, iat,
# and an admin/deployment-admin role. Writes remain disabled until explicitly enabled.
DEPLOYMENT_JWT_SECRET=
DEPLOYMENT_JWT_ISSUER=aurixa
DEPLOYMENT_JWT_AUDIENCE=aurixa-deployment-control-plane
DEPLOYMENT_ADMIN_ROLES=admin,deployment-admin
DEPLOYMENT_WRITES_ENABLED=false
# Exact service names accepted by deployment requests and exposed to the dashboard.
DEPLOYMENT_ALLOWED_SERVICES=api-gateway,orchestration-engine,llm-router,agent-runtime,rag-service,safety-guardrails,streaming-voice,execution-engine,observability-core,deployment-controller,dashboard,patient-portal,hospital-portal

# GitHub App server-side workflow dispatch credentials.
# Store the PEM as a secret; escaped \n line breaks are accepted.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WORKFLOW_FILE=deploy.yml
# Externally reachable gateway callback, for example:
# DEPLOYMENT_CALLBACK_URL=https://api.example.com/api/v1/callbacks/github-actions
DEPLOYMENT_CALLBACK_URL=

# GitHub Actions OIDC callback policy. Repositories are exact owner/name values.
GITHUB_OIDC_AUDIENCE=aurixa-deployment-controller
GITHUB_OIDC_REPOSITORIES=
# Non-production targets that a successful main-branch image workflow may promote automatically.
GITHUB_OIDC_PROMOTION_ENVIRONMENTS=staging
# Local HS256 callback tokens require this explicit secret and are ignored in production.
GITHUB_OIDC_LOCAL_DEV_SECRET=

# Dashboard deployment authentication (server-side only; never prefix secrets with NEXT_PUBLIC_).
# GitHub OAuth requires read:org so membership in an allowed organization/team can be verified.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_ALLOWED_ORGS=
# Optional comma-separated org/team-slug values.
AUTH_GITHUB_ALLOWED_TEAMS=
# Internal URL used only by the dashboard server-side deployment proxy.
DEPLOYMENT_GATEWAY_URL=http://localhost:3000/api/v1/admin/deployments
# Explicit local-only sign-in; ignored when NODE_ENV=production.
DEPLOYMENT_DEV_AUTH_ENABLED=false

# LLM - Local first (LM Studio)
# Start LM Studio, load a model, then providers/models will appear in Dashboard Config
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# When llm-router runs in Docker, use host.docker.internal to reach LM Studio on host:
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Cloud providers - optional; use placeholders to keep selectable
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
GOOGLE_AI_API_KEY=placeholder

# Streaming Voice - Speech-to-Text (STT)
# Primary: OSS (free, no keys). Fallbacks: proprietary.
# OSS (set these for zero-cost, offline STT):
# VOSK_MODEL_PATH=/path/to/vosk-model-en-us-0.22   # Download from alphacephei.com/vosk/models
# FASTER_WHISPER_MODEL=tiny   # tiny|base|small|medium|large-v2 (downloads on first use)
# SPEECHBRAIN_ASR_MODEL=speechbrain/asr-wav2vec2-commonvoice-en   # optional, pip install speechbrain
# Proprietary fallbacks (when OSS fails or for higher accuracy):
# ASSEMBLYAI_API_KEY=...
# DEEPGRAM_API_KEY=...
# OPENAI_API_KEY=sk-...
# STT_PROVIDER_ORDER=vosk,faster_whisper,speechbrain,assemblyai,deepgram,whisper

# Streaming Voice - Text-to-Speech (TTS, optional)
# TTS_PROVIDER=openai   # openai | elevenlabs | none
# OPENAI_API_KEY=sk-... # Used for TTS when TTS_PROVIDER=openai
# ELEVENLABS_API_KEY=... # Used when TTS_PROVIDER=elevenlabs

# Cost optimization - response cache TTL (seconds, 0=disabled)
# ORCHESTRATION_RESPONSE_CACHE_TTL=300

# Database (asyncpg required for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://aurixa:aurixa@localhost:5432/aurixa

# Redis
REDIS_URL=redis://localhost:6379

# Frontend (optional) - Dashboard and Patient Portal proxy /api to gateway via Next.js rewrites
# NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3000
