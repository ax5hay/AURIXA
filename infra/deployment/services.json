      "kind": "frontend",
      "port": 3100,
      "healthPath": "/",
      "dockerfile": "frontend/dashboard/Dockerfile",
      "image": "dashboard",
      "enabled": true
    },
    {
      "name": "client-portal",
      "kind": "frontend",
      "port": 3300,
      "healthPath": "/",
      "dockerfile": "frontend/client-portal/Dockerfile",
      "image": "client-portal",
      "enabled": true
    },
    {
      "name": "agent-workspace",
      "kind": "frontend",
      "port": 3400,
      "healthPath": "/",
      "dockerfile": "frontend/agent-workspace/Dockerfile",
      "image": "agent-workspace",
      "enabled": true
    }
