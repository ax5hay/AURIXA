{
  "name": "aurixa",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time conversational AI orchestration platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "cd packages/db && python seed.py",
    "deploy": "node scripts/deploy.js",
    "deploy:validate": "node scripts/deploy.js validate",
    "deploy:build": "node scripts/deploy.js build",
    "deploy:verify": "node scripts/deploy.js verify",
    "deploy:up": "node scripts/deploy.js up",
    "deploy:down": "node scripts/deploy.js down",
    "deploy:status": "node scripts/deploy.js status",
    "test:e2e": "pnpm --filter @aurixa/e2e test:smoke",
    "test:visual": "pnpm --filter @aurixa/e2e test:visual",
    "budget:frontends": "node scripts/frontend-bundle-budget.mjs",
    "check:domain-copy": "bash scripts/check-real-estate-domain-copy.sh",
    "demo:videos": "bash scripts/record-demo-videos.sh"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
